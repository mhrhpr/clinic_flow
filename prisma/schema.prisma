generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics Clinic[]
  users   User[]
}

model Clinic {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  locale         String   @default("en-US")
  timezone       String   @default("UTC")
  currency       String   @default("USD")
  logoUrl        String?
  primaryColor   String   @default("#0f766e")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  ClinicMembership[]
  patients     Patient[]
  appointments Appointment[]
  services     Service[]
  treatments   Treatment[]
  invoices     Invoice[]
  payments     Payment[]
  expenses     Expense[]
  settings     ClinicSetting[]
  features     ClinicFeature[]
  workflows    WorkflowDefinition[]
  customFields CustomFieldDefinition[]
  auditLogs    AuditLog[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([isActive])
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  ClinicMembership[]
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([email])
}

enum Role {
  OWNER
  ADMIN
  DOCTOR
  RECEPTIONIST
  ACCOUNTANT
  STAFF
}

model ClinicMembership {
  id        String   @id @default(uuid())
  clinicId  String
  userId    String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@index([userId])
  @@index([clinicId, role])
}

model Patient {
  id          String   @id @default(uuid())
  clinicId    String
  externalId  String?
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  treatments   Treatment[]
  invoices     Invoice[]

  @@index([clinicId])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, phone])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(uuid())
  clinicId    String
  patientId   String
  providerId  String?
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, startsAt])
  @@index([clinicId, patientId, startsAt])
  @@index([providerId, startsAt])
}

model Service {
  id          String   @id @default(uuid())
  clinicId    String
  code        String
  name        String
  description String?
  price       Decimal  @db.Decimal(18, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic     Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatments Treatment[]
  items      InvoiceItem[]

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
}

model Treatment {
  id          String   @id @default(uuid())
  clinicId    String
  patientId   String
  serviceId   String?
  performedAt DateTime?
  status      String   @default("PLANNED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, status])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

model Invoice {
  id        String        @id @default(uuid())
  clinicId  String
  patientId String
  number    String
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  subtotal  Decimal       @db.Decimal(18, 2)
  discount  Decimal       @default(0) @db.Decimal(18, 2)
  tax       Decimal       @default(0) @db.Decimal(18, 2)
  total     Decimal       @db.Decimal(18, 2)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  clinic   Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([clinicId, number])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@index([clinicId, issueDate])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

model Payment {
  id        String        @id @default(uuid())
  clinicId  String
  invoiceId String
  amount    Decimal       @db.Decimal(18, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?
  createdAt DateTime      @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clinicId, paidAt])
  @@index([clinicId, invoiceId])
}

model Expense {
  id          String   @id @default(uuid())
  clinicId    String
  category    String
  description String?
  amount      Decimal  @db.Decimal(18, 2)
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, incurredAt])
  @@index([clinicId, category])
}

model ClinicSetting {
  id        String   @id @default(uuid())
  clinicId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
}

model ClinicFeature {
  id        String   @id @default(uuid())
  clinicId  String
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
}

model WorkflowDefinition {
  id         String         @id @default(uuid())
  clinicId   String
  key        String
  name       String
  status     WorkflowStatus @default(ACTIVE)
  definition Json
  version    Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
  @@index([clinicId, status])
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
}

model CustomFieldDefinition {
  id        String          @id @default(uuid())
  clinicId  String
  entity    String
  key       String
  label     String
  type      CustomFieldType
  required  Boolean         @default(false)
  options   Json?
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([clinicId, entity, key])
  @@index([clinicId, entity, position])
}

model CustomFieldValue {
  id        String   @id @default(uuid())
  fieldId   String
  entity    String
  entityId  String
  value     Json
  updatedAt DateTime @updatedAt

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([entity, entityId])
}

model AuditLog {
  id        String   @id @default(uuid())
  clinicId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([clinicId, entity, entityId])
}
